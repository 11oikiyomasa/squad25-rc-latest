{
  "name": "mlbb-squad-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:unit": "npx --yes tsx@4.23.13 --test tests/unit/*.test.ts",
    "test:integration": "npx --yes tsx@4.23.13 --test tests/integration/*.test.ts",
    "test:regression": "npx --yes tsx@4.23.13 --test tests/regression/*.test.ts",
    "test:e2e": "npm install --no-save --package-lock=false @playwright/test@1.62.1 && npx playwright test",
    "test": "npm run test:unit && npm run test:regression",
    "verify": "node scripts/verify.mjs && node scripts/verify-recruitment.mjs && node scripts/verify-scrims.mjs && node scripts/verify-media.mjs && node scripts/verify-agent-contract.mjs"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3"
  }
}
