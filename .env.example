# Public Supabase configuration used by the server-side SSR client and safe browser-facing clients.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase credentials for the official CLI/type-generation flow.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# Server-only Supabase credential. NEVER expose this through NEXT_PUBLIC_* or browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Upstash REST credentials used by the recruitment edge/request limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public canonical URL used for navigation, metadata, and strict Origin checks.
NEXT_PUBLIC_SITE_URL=https://squad25-rc-latest.vercel.app
